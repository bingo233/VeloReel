{
  "name": "electron-stream-player",
  "version": "0.1.0",
  "private": true,
  "description": "A privacy-first Electron video player with rule-based discovery, stream extraction and local HLS acceleration.",
  "main": "./out/main/index.js",
  "author": "videoPlayer contributors",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:fullscreen": "node tests/electron/runFullscreen.mjs",
    "test:security": "node tests/electron/runSecurity.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "artplayer": "^5.4.0",
    "cheerio": "^1.0.0",
    "electron-store": "^10.0.1",
    "hls.js": "^1.5.18",
    "openai": "^7.47.0",
    "undici": "^7.30.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  },
  "build": {
    "appId": "com.local.streamplayer",
    "productName": "流光播放器",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
